# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# bin/release on forge-1 builds into releases/<sha> and symlinks current, both
# inside the working tree. Tailwind's content scan respects .gitignore, so
# leaving these tracked makes every build harvest class names out of the
# PREVIOUS release's compiled output.
releases/
current

# Runtime settings live in the box's env file; a local .env for astro dev must never be staged.
.env
.env.*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
