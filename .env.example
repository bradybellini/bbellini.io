# The unit's EnvironmentFile on forge-1 is ~/.config/pi-sites/bbellini-io.env
# (0600). Locally, copy this to .env: astro.config.mjs loads it for
# `bun run dev`, and bun loads it for `bun run preview`.

# The standalone server's listener (`bun run preview` and the box; port per
# forge/sites.map). `astro dev` ignores these and serves on 4321.
HOST=127.0.0.1
PORT=4015

# Tomorrow.io realtime weather, read by /api/weather. Unset fails closed: the
# route answers 500 and the header widget shows ERR.
TOMORROW_API_KEY=
