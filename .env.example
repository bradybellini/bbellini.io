# The unit's EnvironmentFile on forge-1 is ~/.config/pi-sites/bbellini-io.env
# (0600). Locally, copy this to .env for `astro dev`.

# The listener. Port per forge/sites.map.
HOST=127.0.0.1
PORT=4015

# Tomorrow.io realtime weather, read by /api/weather. Unset fails closed: the
# route answers 500 and the header widget shows ERR.
TOMORROW_API_KEY=
