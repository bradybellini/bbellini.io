{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": [
      "bun",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "releases"
  ]
}
